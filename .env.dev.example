IMSUB_TELEGRAM_BOT_TOKEN=
IMSUB_TWITCH_CLIENT_ID=
IMSUB_TWITCH_CLIENT_SECRET=
IMSUB_TWITCH_EVENTSUB_SECRET=dev-eventsub-secret
IMSUB_TELEGRAM_WEBHOOK_SECRET=

# Required by config validation even when running Telegram in polling mode.
# For ngrok webhook mode, pass PUBLIC_BASE_URL=https://... to `make run-tunnel`,
# or replace this with the active ngrok HTTPS URL before starting the app.
IMSUB_PUBLIC_BASE_URL=http://localhost:8080
IMSUB_TWITCH_WEBHOOK_PATH=/webhooks/twitch
IMSUB_TELEGRAM_WEBHOOK_PATH=/webhooks/telegram
IMSUB_LISTEN_ADDR=:8080

# The default local Redis runs in the devcontainer compose stack.
IMSUB_REDIS_URL=redis://default:@redis:6379/0

IMSUB_DEBUG_LOGS=true
IMSUB_METRICS_ENABLED=true
IMSUB_METRICS_PATH=/metrics

# Local app runs without S3 backup configuration.
# The `imsub-admin` download command reads backup storage credentials from .env.
