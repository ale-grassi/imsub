{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Imsub: Run App",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/imsub",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.dev"
    },
    {
      "name": "Imsub: Run Tunnel Mode",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/imsub",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.dev",
      "env": {
        "IMSUB_REDIS_URL": "redis://default:@redis:6379/0"
      }
    },
    {
      "name": "Imsub: Run App With Example Env",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/imsub",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.dev.example"
    },
    {
      "name": "Imsub: Debug Integration Tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/tests/integration",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags=integration",
      "envFile": "${workspaceFolder}/.env.dev"
    }
  ]
}
