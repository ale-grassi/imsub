IMSUB_TELEGRAM_BOT_TOKEN=
IMSUB_TELEGRAM_WEBHOOK_SECRET=
IMSUB_TWITCH_CLIENT_ID=
IMSUB_TWITCH_CLIENT_SECRET=
IMSUB_TWITCH_EVENTSUB_SECRET=
IMSUB_PUBLIC_BASE_URL=https://imsub.fly.dev
IMSUB_TWITCH_WEBHOOK_PATH=/webhooks/twitch
IMSUB_TELEGRAM_WEBHOOK_PATH=/webhooks/telegram
IMSUB_LISTEN_ADDR=:8080
IMSUB_REDIS_URL=rediss://default:password@host:port
IMSUB_DEBUG_LOGS=false
IMSUB_METRICS_ENABLED=true
